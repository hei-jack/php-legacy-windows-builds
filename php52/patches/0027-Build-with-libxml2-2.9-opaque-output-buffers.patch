From: lpgauthier <lpgauthier@circworld.qc.ca>
Date: Fri, 23 Oct 2026 13:42:50 -0400
Subject: [PATCH 27/28] Build with libxml2 2.9 (opaque output buffers)

Since libxml2 2.9, xmlOutputBuffer->buffer is an opaque xmlBuf, so
DOMDocumentType::internalSubset, DOMNode::C14N() and
SimpleXMLElement::asXML() no longer compile when they read
->buffer->content / ->buffer->use. Use xmlOutputBufferGetContent() /
xmlOutputBufferGetSize() when libxml2 defines LIBXML2_NEW_BUFFER, as
PHP 5.3.21+/5.4.11+ do; older libxml2 keeps the original code.

Needed by the Windows kit, which builds php5ts.dll against libxml2
2.9.14. Checked on Linux against libxml2 2.9.14: builds, and the
dom/simplexml/xml/xmlreader/xmlwriter/libxml/wddx suites pass except
for two libxml2 behaviour changes (saveHTML() whitespace in dom005,
nested XInclude in bug43364).

Source: php-src PHP-5.3 (ext/dom/documenttype.c, ext/dom/node.c,
ext/simplexml/simplexml.c).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/dom/documenttype.c    | 4 ++++
 ext/dom/node.c            | 8 ++++++++
 ext/simplexml/simplexml.c | 4 ++++
 3 files changed, 16 insertions(+)

diff --git a/ext/dom/documenttype.c b/ext/dom/documenttype.c
index 000c03b9f4..632bfa4ec3 100644
--- a/ext/dom/documenttype.c
+++ b/ext/dom/documenttype.c
@@ -215,7 +215,11 @@ int dom_documenttype_internal_subset_read(dom_object *obj, zval **retval TSRMLS_
 		if (buff != NULL) {
 			xmlNodeDumpOutput (buff, NULL, (xmlNodePtr) intsubset, 0, 0, NULL);
 			xmlOutputBufferFlush(buff);
+#ifdef LIBXML2_NEW_BUFFER
+			ZVAL_STRINGL(*retval, (char *) xmlOutputBufferGetContent(buff), xmlOutputBufferGetSize(buff), 1);
+#else
 			ZVAL_STRINGL(*retval, buff->buffer->content, buff->buffer->use, 1);
+#endif
 			(void)xmlOutputBufferClose(buff);
 			return SUCCESS;
 		}
diff --git a/ext/dom/node.c b/ext/dom/node.c
index 0d2bc778e1..3234342ddc 100644
--- a/ext/dom/node.c
+++ b/ext/dom/node.c
@@ -1950,9 +1950,17 @@ static void dom_canonicalization(INTERNAL_FUNCTION_PARAMETERS, int mode)
         RETVAL_FALSE;
     } else {
 		if (mode == 0) {
+#ifdef LIBXML2_NEW_BUFFER
+			ret = xmlOutputBufferGetSize(buf);
+#else
 			ret = buf->buffer->use;
+#endif
 			if (ret > 0) {
+#ifdef LIBXML2_NEW_BUFFER
+				RETVAL_STRINGL((char *) xmlOutputBufferGetContent(buf), ret, 1);
+#else
 				RETVAL_STRINGL((char *) buf->buffer->content, ret, 1);
+#endif
 			} else {
 				RETVAL_EMPTY_STRING();
 			}
diff --git a/ext/simplexml/simplexml.c b/ext/simplexml/simplexml.c
index 8e78524617..718e63fea6 100644
--- a/ext/simplexml/simplexml.c
+++ b/ext/simplexml/simplexml.c
@@ -1343,7 +1343,11 @@ SXE_METHOD(asXML)
 
 			xmlNodeDumpOutput(outbuf, (xmlDocPtr) sxe->document->ptr, node, 0, 0, ((xmlDocPtr) sxe->document->ptr)->encoding);
 			xmlOutputBufferFlush(outbuf);
+#ifdef LIBXML2_NEW_BUFFER
+			RETVAL_STRINGL((char *)xmlOutputBufferGetContent(outbuf), xmlOutputBufferGetSize(outbuf), 1);
+#else
 			RETVAL_STRINGL((char *)outbuf->buffer->content, outbuf->buffer->use, 1);
+#endif
 			xmlOutputBufferClose(outbuf);
 		}
 	} else {
